# Copy the names below into the pod's Secrets panel or the environment.
# Never commit real values. The server reads these from the environment.

# Public address of the site, used for the Google sign-in return address.
BASE_URL=https://territorial-mink-85a7.podway.site
# Port the server listens on. Use the port of the pod's preview.
PORT=8080
# Folder for the database. It must be inside the pod's persistent workspace.
DATA_DIR=./data

# Long random string that signs sessions and makes rating keys one-way.
SESSION_SECRET=

# Google sign-in (OAuth client of type "Web application").
# Authorized redirect URI: <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Addresses that sign in as the teacher, separated by commas.
TEACHER_EMAILS=

# Password of the demo login "demo".
DEMO_PASSWORD=

# Claude API key for the tutor and for grouping comments into themes. Optional.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-sonnet-5-5
# Model of the helper button. Optional.
HELPER_MODEL=claude-sonnet-5-5
# The most the site may spend on the Claude API in a month, in dollars. Default 20.
AI_MONTHLY_CAP_USD=20

# GitHub token for repository checks. Optional; without it GitHub allows 60 requests an hour.
GITHUB_TOKEN=

# Development only: lets anyone sign in as any address at /auth/dev. Never set it in the pod.
DEV_LOGIN=
